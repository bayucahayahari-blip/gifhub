<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JARVIS - AI Assistant</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0c0c0c 0%, #1a1a2e 50%, #16213e 100%);
            color: #00ffff;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .container {
            max-width: 100vw;
            margin: 0 auto;
            padding: 10px;
            min-height: 100vh;
            position: relative;
        }

        .header {
            text-align: center;
            padding: 20px 0;
            background: rgba(0, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            margin-bottom: 20px;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .logo {
            font-size: 2.5em;
            font-weight: bold;
            text-shadow: 0 0 20px #00ffff;
            margin-bottom: 10px;
            animation: glow 2s ease-in-out infinite alternate;
        }

        @keyframes glow {
            from { text-shadow: 0 0 20px #00ffff; }
            to { text-shadow: 0 0 30px #00ffff, 0 0 40px #00ffff; }
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .status-item {
            text-align: center;
            flex: 1;
        }

        .status-value {
            font-size: 1.2em;
            font-weight: bold;
            color: #00ffff;
        }

        .status-label {
            font-size: 0.8em;
            color: #888;
            margin-top: 5px;
        }

        .voice-control {
            text-align: center;
            margin: 30px 0;
        }

        .voice-btn {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(45deg, #00ffff, #0080ff);
            border: 3px solid #00ffff;
            color: white;
            font-size: 1.2em;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
        }

        .voice-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 0 50px rgba(0, 255, 255, 0.8);
        }

        .voice-btn.listening {
            animation: pulse 1s infinite;
            background: linear-gradient(45deg, #ff0080, #ff4000);
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .chat-container {
            background: rgba(0, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .message {
            margin: 10px 0;
            padding: 10px 15px;
            border-radius: 20px;
            max-width: 85%;
            word-wrap: break-word;
        }

        .user-message {
            background: linear-gradient(45deg, #0080ff, #00ffff);
            margin-left: auto;
            text-align: right;
        }

        .ai-message {
            background: rgba(0, 255, 255, 0.2);
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 20px 0;
        }

        .feature-card {
            background: rgba(0, 255, 255, 0.1);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .feature-card:hover {
            background: rgba(0, 255, 255, 0.2);
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 255, 255, 0.3);
        }

        .feature-icon {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .weather-widget {
            background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), rgba(0, 128, 255, 0.1));
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            border: 1px solid rgba(0, 255, 255, 0.3);
        }

        .weather-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .weather-temp {
            font-size: 2.5em;
            font-weight: bold;
        }

        .weather-details {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            font-size: 0.9em;
        }

        .input-container {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            padding: 15px;
            border-top: 1px solid rgba(0, 255, 255, 0.3);
        }

        .input-group {
            display: flex;
            gap: 10px;
        }

        #userInput {
            flex: 1;
            background: rgba(0, 255, 255, 0.1);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 25px;
            padding: 12px 20px;
            color: #00ffff;
            font-size: 16px;
        }

        #userInput::placeholder {
            color: #666;
        }

        .send-btn {
            background: linear-gradient(45deg, #00ffff, #0080ff);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            color: white;
            cursor: pointer;
            font-size: 1.2em;
        }

        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(0, 255, 255, 0.9);
            color: #000;
            padding: 15px 20px;
            border-radius: 10px;
            font-weight: bold;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            z-index: 1000;
        }

        .notification.show {
            transform: translateX(0);
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(0, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #00ffff;
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Camera Module Styles */
        .camera-module {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.95);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .camera-container {
            width: 90vw;
            max-width: 500px;
            background: rgba(0, 255, 255, 0.1);
            border: 1px solid rgba(0, 255, 255, 0.3);
            border-radius: 15px;
            padding: 20px;
            backdrop-filter: blur(10px);
        }

        .camera-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .close-btn {
            background: rgba(255, 0, 0, 0.7);
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            color: white;
            cursor: pointer;
            font-size: 1.2em;
        }

        #cameraVideo {
            width: 100%;
            height: 250px;
            border-radius: 10px;
            background: #000;
            object-fit: cover;
        }

        .camera-controls {
            display: flex;
            justify-content: space-around;
            margin: 15px 0;
            gap: 10px;
        }

        .cam-btn {
            flex: 1;
            padding: 12px 8px;
            background: linear-gradient(45deg, #00ffff, #0080ff);
            border: none;
            border-radius: 8px;
            color: white;
            cursor: pointer;
            font-size: 0.9em;
            transition: all 0.3s ease;
        }

        .cam-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 255, 255, 0.4);
        }

        .analysis-results {
            background: rgba(0, 255, 255, 0.05);
            border: 1px solid rgba(0, 255, 255, 0.2);
            border-radius: 10px;
            padding: 15px;
            margin-top: 15px;
            min-height: 60px;
            max-height: 150px;
            overflow-y: auto;
        }

        .analysis-item {
            margin: 8px 0;
            padding: 8px 12px;
            background: rgba(0, 255, 255, 0.1);
            border-radius: 8px;
            font-size: 0.9em;
        }

        .confidence-bar {
            background: rgba(0, 255, 255, 0.2);
            height: 4px;
            border-radius: 2px;
            margin-top: 5px;
            overflow: hidden;
        }

        .confidence-fill {
            background: linear-gradient(90deg, #00ffff, #0080ff);
            height: 100%;
            transition: width 0.5s ease;
        }

        @media (max-width: 768px) {
            .container { padding: 5px; }
            .logo { font-size: 2em; }
            .voice-btn { width: 100px; height: 100px; }
            .feature-grid { grid-template-columns: repeat(2, 1fr); }
            .chat-container { margin-bottom: 80px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">J.A.R.V.I.S</div>
            <div style="font-size: 0.9em; opacity: 0.8;">Just A Rather Very Intelligent System</div>
        </div>

        <div class="status-bar">
            <div class="status-item">
                <div class="status-value" id="currentTime">00:00</div>
                <div class="status-label">Waktu</div>
            </div>
            <div class="status-item">
                <div class="status-value" id="batteryLevel">100%</div>
                <div class="status-label">Baterai</div>
            </div>
            <div class="status-item">
                <div class="status-value" id="connectionStatus">Online</div>
                <div class="status-label">Status</div>
            </div>
        </div>

        <div class="voice-control">
            <button class="voice-btn" id="voiceBtn" onclick="toggleVoiceRecognition()">
                🎤
            </button>
            <div style="margin-top: 15px; font-size: 0.9em;">Tekan untuk berbicara</div>
        </div>

        <div class="weather-widget">
            <div class="weather-main">
                <div>
                    <div id="weatherLocation">Jakarta, ID</div>
                    <div class="weather-temp" id="weatherTemp">28°C</div>
                </div>
                <div style="font-size: 3em;" id="weatherIcon">☀️</div>
            </div>
            <div class="weather-details">
                <div>Kelembaban: <span id="humidity">65%</span></div>
                <div>Angin: <span id="windSpeed">5 km/h</span></div>
                <div>Tekanan: <span id="pressure">1013 hPa</span></div>
                <div>UV Index: <span id="uvIndex">6</span></div>
            </div>
        </div>

        <div class="feature-grid">
            <div class="feature-card" onclick="executeCommand('weather')">
                <div class="feature-icon">🌤️</div>
                <div>Cuaca</div>
            </div>
            <div class="feature-card" onclick="executeCommand('news')">
                <div class="feature-icon">📰</div>
                <div>Berita</div>
            </div>
            <div class="feature-card" onclick="executeCommand('calculator')">
                <div class="feature-icon">🧮</div>
                <div>Kalkulator</div>
            </div>
            <div class="feature-card" onclick="executeCommand('timer')">
                <div class="feature-icon">⏰</div>
                <div>Timer</div>
            </div>
            <div class="feature-card" onclick="executeCommand('reminder')">
                <div class="feature-icon">📝</div>
                <div>Pengingat</div>
            </div>
            <div class="feature-card" onclick="executeCommand('music')">
                <div class="feature-icon">🎵</div>
                <div>Musik</div>
            </div>
            <div class="feature-card" onclick="executeCommand('maps')">
                <div class="feature-icon">🗺️</div>
                <div>Peta</div>
            </div>
            <div class="feature-card" onclick="executeCommand('translate')">
                <div class="feature-icon">🌐</div>
                <div>Terjemahan</div>
            </div>
            <div class="feature-card" onclick="executeCommand('camera')">
                <div class="feature-icon">📸</div>
                <div>Kamera AI</div>
            </div>
            <div class="feature-card" onclick="executeCommand('scan')">
                <div class="feature-icon">🔍</div>
                <div>Scan & Analisis</div>
            </div>
        </div>

        <!-- Camera Module -->
        <div class="camera-module" id="cameraModule" style="display: none;">
            <div class="camera-container">
                <div class="camera-header">
                    <h3>📸 Kamera Analitik JARVIS</h3>
                    <button class="close-btn" onclick="closeCameraModule()">✕</button>
                </div>
                <video id="cameraVideo" autoplay playsinline></video>
                <canvas id="cameraCanvas" style="display: none;"></canvas>
                <div class="camera-controls">
                    <button class="cam-btn" onclick="captureImage()">📷 Ambil Foto</button>
                    <button class="cam-btn" onclick="toggleAnalysisMode()">🔍 Mode Analisis</button>
                    <button class="cam-btn" onclick="scanText()">📝 Scan Teks</button>
                </div>
                <div class="analysis-results" id="analysisResults"></div>
            </div>
        </div>

        <div class="chat-container" id="chatContainer">
            <div class="ai-message">
                Halo! Saya JARVIS, asisten virtual Anda. Bagaimana saya bisa membantu Anda hari ini?
            </div>
        </div>
    </div>

    <div class="input-container">
        <div class="input-group">
            <input type="text" id="userInput" placeholder="Ketik pesan atau perintah..." onkeypress="handleKeyPress(event)">
            <button class="send-btn" onclick="sendMessage()">➤</button>
        </div>
    </div>

    <div class="notification" id="notification"></div>

    <script>
        let isListening = false;
        let recognition;
        let chatHistory = [];
        let cameraStream = null;
        let analysisMode = false;

        // Indonesian local language patterns
        const indonesianPatterns = {
            greetings: ['halo', 'hai', 'selamat pagi', 'selamat siang', 'selamat malam', 'apa kabar', 'gimana'],
            weather: ['cuaca', 'hujan', 'panas', 'dingin', 'mendung', 'cerah', 'berawan'],
            time: ['jam', 'waktu', 'pukul', 'sekarang', 'tanggal', 'hari'],
            calculation: ['hitung', 'plus', 'tambah', 'kurang', 'kali', 'bagi', 'persen'],
            camera: ['foto', 'kamera', 'ambil gambar', 'potret', 'scan', 'analisis', 'lihat'],
            music: ['musik', 'lagu', 'putar', 'play', 'nyalakan musik'],
            navigation: ['arah', 'jalan', 'rute', 'lokasi', 'alamat', 'dimana', 'kemana'],
            news: ['berita', 'news', 'kabar', 'informasi', 'update'],
            thanks: ['terima kasih', 'makasih', 'thanks', 'thx'],
            goodbye: ['bye', 'dadah', 'sampai jumpa', 'selamat tinggal'],
            question: ['apa', 'siapa', 'kapan', 'dimana', 'bagaimana', 'kenapa', 'mengapa'],
            affirmative: ['ya', 'iya', 'benar', 'betul', 'oke', 'baik', 'setuju'],
            negative: ['tidak', 'enggak', 'nggak', 'bukan', 'salah', 'jangan']
        };

        // Initialize speech recognition
        if ('webkitSpeechRecognition' in window) {
            recognition = new webkitSpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = false;
            recognition.lang = 'id-ID';

            recognition.onstart = function() {
                isListening = true;
                document.getElementById('voiceBtn').classList.add('listening');
                document.getElementById('voiceBtn').innerHTML = '🔴';
            };

            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processVoiceCommand(transcript);
            };

            recognition.onend = function() {
                isListening = false;
                document.getElementById('voiceBtn').classList.remove('listening');
                document.getElementById('voiceBtn').innerHTML = '🎤';
            };
        }

        // Voice recognition toggle
        function toggleVoiceRecognition() {
            if (!recognition) {
                showNotification('Speech recognition tidak didukung pada browser ini');
                return;
            }

            if (isListening) {
                recognition.stop();
            } else {
                recognition.start();
            }
        }

        // Process voice commands
        function processVoiceCommand(command) {
            addMessage(command, 'user');
            setTimeout(() => {
                const response = getAIResponse(command);
                addMessage(response, 'ai');
                speakResponse(response);
            }, 1000);
        }

        // Text to speech
        function speakResponse(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'id-ID';
                utterance.rate = 0.9;
                speechSynthesis.speak(utterance);
            }
        }

        // Handle keyboard input
        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }

        // Send message
        function sendMessage() {
            const input = document.getElementById('userInput');
            const message = input.value.trim();
            
            if (message) {
                addMessage(message, 'user');
                input.value = '';
                
                setTimeout(() => {
                    const response = getAIResponse(message);
                    addMessage(response, 'ai');
                    speakResponse(response);
                }, 1000);
            }
        }

        // Add message to chat
        function addMessage(message, type) {
            const chatContainer = document.getElementById('chatContainer');
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type}-message`;
            messageDiv.textContent = message;
            chatContainer.appendChild(messageDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
            
            chatHistory.push({type, message, timestamp: new Date()});
        }

        // Get AI response with Indonesian language understanding
        function getAIResponse(input) {
            const lowerInput = input.toLowerCase();
            const response = analyzeIndonesianInput(lowerInput);
            
            if (response) return response;
            
            // Existing pattern matching...
            if (lowerInput.includes('cuaca') || lowerInput.includes('weather')) {
                updateWeather();
                return 'Menampilkan informasi cuaca terkini untuk lokasi Anda.';
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.time)) {
                const now = new Date();
                return `Sekarang hari ${getDayInIndonesian(now.getDay())}, ${now.toLocaleDateString('id-ID')} pukul ${now.toLocaleTimeString('id-ID')}.`;
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.camera)) {
                setTimeout(() => openCameraModule(), 1000);
                return 'Membuka kamera analitik JARVIS untuk Anda.';
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.calculation)) {
                return 'Silakan berikan perhitungan yang ingin Anda lakukan. Misalnya: "hitung 25 tambah 17" atau "berapa 15 persen dari 200".';
            }
            
            if (lowerInput.includes('musik') || lowerInput.includes('lagu')) {
                return 'Maaf, saya tidak dapat memutar musik secara langsung. Silakan buka aplikasi musik favorit Anda seperti Spotify atau YouTube Music.';
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.news)) {
                return 'Menampilkan berita terkini dari Indonesia... Untuk berita lengkap, silakan kunjungi detik.com, kompas.com, atau sumber berita terpercaya lainnya.';
            }
            
            if (lowerInput.includes('timer') || lowerInput.includes('alarm')) {
                return 'Timer sedang diatur. Saya akan memberi tahu Anda ketika waktu habis. Berapa lama waktu yang Anda inginkan?';
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.navigation)) {
                return 'Membuka layanan peta dan navigasi. Pastikan GPS Anda aktif untuk mendapatkan arah yang akurat.';
            }
            
            if (lowerInput.includes('terjemah') || lowerInput.includes('translate')) {
                return 'Layanan terjemahan siap digunakan. Silakan berikan teks yang ingin diterjemahkan dari bahasa apa ke bahasa apa.';
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.greetings)) {
                const greetings = [
                    'Halo! Senang bertemu dengan Anda. Ada yang bisa saya bantu?',
                    'Hai! Saya JARVIS, siap membantu Anda hari ini.',
                    'Selamat datang! Bagaimana kabar Anda hari ini?',
                    'Halo! Semoga hari Anda menyenangkan. Ada yang perlu bantuan?'
                ];
                return greetings[Math.floor(Math.random() * greetings.length)];
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.thanks)) {
                const thankResponses = [
                    'Sama-sama! Selalu siap membantu Anda.',
                    'Dengan senang hati! Ada lagi yang bisa saya bantu?',
                    'Terima kasih kembali! Senang bisa membantu.',
                    'Tidak masalah! Saya di sini untuk membantu Anda.'
                ];
                return thankResponses[Math.floor(Math.random() * thankResponses.length)];
            }
            
            if (matchesPattern(lowerInput, indonesianPatterns.goodbye)) {
                const goodbyes = [
                    'Sampai jumpa! Jangan ragu untuk kembali jika butuh bantuan.',
                    'Selamat tinggal! Semoga hari Anda menyenangkan.',
                    'Dadah! Terima kasih sudah menggunakan JARVIS.',
                    'Bye! Sampai bertemu lagi nanti.'
                ];
                return goodbyes[Math.floor(Math.random() * goodbyes.length)];
            }
            
            // Mathematical expressions in Indonesian
            if (containsMathExpression(lowerInput)) {
                return processMathInIndonesian(lowerInput);
            }
            
            // Default responses in Indonesian
            const responses = [
                'Maaf, saya belum sepenuhnya memahami permintaan Anda. Bisa dijelaskan dengan cara lain?',
                'Hmm, sepertinya saya perlu belajar lebih banyak tentang ini. Ada yang bisa saya bantu yang lain?',
                'Perintah tersebut masih dalam pengembangan. Silakan coba fitur lain yang tersedia.',
                'Saya akan mencoba membantu sebaik mungkin. Bisa berikan instruksi yang lebih spesifik?',
                'Maaf, saya tidak yakin dengan maksud Anda. Coba gunakan kata kunci yang lebih jelas ya.'
            ];
            
            return responses[Math.floor(Math.random() * responses.length)];
        }

        // Analyze Indonesian input patterns
        function analyzeIndonesianInput(input) {
            // Handle complex Indonesian sentences
            if (input.includes('bagaimana') && (input.includes('cuaca') || input.includes('hari ini'))) {
                updateWeather();
                return 'Cuaca hari ini cukup cerah dengan suhu sekitar 28°C. Cocok untuk beraktivitas di luar ruangan.';
            }
            
            if (input.includes('dimana') && input.includes('lokasi')) {
                return 'Untuk mengetahui lokasi Anda, saya perlu akses GPS. Pastikan lokasi diaktifkan di browser Anda.';
            }
            
            if (input.includes('apa') && input.includes('bisa') && input.includes('lakukan')) {
                return 'Saya bisa membantu dengan cuaca, kalkulator, timer, berita, kamera analitik, navigasi, terjemahan, dan banyak lagi. Coba katakan "bantuan" untuk melihat semua fitur.';
            }
            
            return null;
        }

        // Check if input matches pattern
        function matchesPattern(input, patterns) {
            return patterns.some(pattern => input.includes(pattern));
        }

        // Get Indonesian day name
        function getDayInIndonesian(dayIndex) {
            const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            return days[dayIndex];
        }

        // Check for mathematical expressions
        function containsMathExpression(input) {
            const mathKeywords = ['tambah', 'kurang', 'kali', 'bagi', 'plus', 'minus', 'dikali', 'dibagi', 'persen', 'pangkat'];
            return mathKeywords.some(keyword => input.includes(keyword)) || /\d+/.test(input);
        }

        // Process math in Indonesian
        function processMathInIndonesian(input) {
            try {
                // Convert Indonesian math terms to operators
                let expression = input
                    .replace(/tambah|plus/g, '+')
                    .replace(/kurang|minus/g, '-')
                    .replace(/kali|dikali/g, '*')
                    .replace(/bagi|dibagi/g, '/')
                    .replace(/persen/g, '/100');
                
                // Extract numbers and operators
                const mathMatch = expression.match(/(\d+(?:\.\d+)?)\s*([+\-*/])\s*(\d+(?:\.\d+)?)/);
                if (mathMatch) {
                    const result = eval(mathMatch[0]);
                    return `Hasil perhitungan: ${mathMatch[0]} = ${result}`;
                }
                
                // Handle percentage calculations
                const percentMatch = input.match(/(\d+)\s*persen\s*dari\s*(\d+)/);
                if (percentMatch) {
                    const result = (parseFloat(percentMatch[1]) / 100) * parseFloat(percentMatch[2]);
                    return `${percentMatch[1]}% dari ${percentMatch[2]} = ${result}`;
                }
                
                return 'Silakan berikan perhitungan dalam format yang jelas, seperti "25 tambah 17" atau "15 persen dari 200".';
            } catch (error) {
                return 'Maaf, saya tidak bisa menghitung ekspresi tersebut. Coba format yang lebih sederhana.';
            }
        }

        // Execute feature commands
        function executeCommand(command) {
            const responses = {
                weather: 'Memperbarui informasi cuaca...',
                news: 'Mengambil berita terkini...',
                calculator: 'Membuka kalkulator...',
                timer: 'Mengatur timer...',
                reminder: 'Membuat pengingat...',
                music: 'Mencari musik...',
                maps: 'Membuka peta...',
                translate: 'Layanan terjemahan siap...',
                camera: 'Mengaktifkan kamera analitik...',
                scan: 'Mempersiapkan mode scan dan analisis...'
            };
            
            addMessage(`Perintah: ${command}`, 'user');
            setTimeout(() => {
                addMessage(responses[command] || 'Perintah dijalankan', 'ai');
                
                if (command === 'weather') {
                    updateWeather();
                } else if (command === 'calculator') {
                    showCalculator();
                } else if (command === 'camera' || command === 'scan') {
                    openCameraModule();
                }
            }, 1000);
        }

        // Camera Functions
        async function openCameraModule() {
            const cameraModule = document.getElementById('cameraModule');
            const video = document.getElementById('cameraVideo');
            
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { 
                        facingMode: 'environment',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    }
                });
                
                video.srcObject = cameraStream;
                cameraModule.style.display = 'flex';
                
                showNotification('Kamera aktif - Siap untuk analisis');
            } catch (error) {
                showNotification('Error: Tidak dapat mengakses kamera');
                console.error('Camera error:', error);
            }
        }

        function closeCameraModule() {
            const cameraModule = document.getElementById('cameraModule');
            
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
            
            cameraModule.style.display = 'none';
            analysisMode = false;
        }

        function captureImage() {
            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('cameraCanvas');
            const ctx = canvas.getContext('2d');
            
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            
            ctx.drawImage(video, 0, 0);
            
            // Simulate image analysis
            analyzeImage(canvas);
            
            showNotification('Foto diambil dan sedang dianalisis...');
        }

        function analyzeImage(canvas) {
            const resultsDiv = document.getElementById('analysisResults');
            resultsDiv.innerHTML = '<div class="loading"></div> Menganalisis gambar...';
            
            // Simulate AI analysis with Indonesian responses
            setTimeout(() => {
                const analysisResults = [
                    { 
                        type: 'Objek Terdeteksi', 
                        description: 'Smartphone, meja, buku', 
                        confidence: 0.89 
                    },
                    { 
                        type: 'Warna Dominan', 
                        description: 'Biru (32%), Putih (28%), Hitam (21%)', 
                        confidence: 0.95 
                    },
                    { 
                        type: 'Pencahayaan', 
                        description: 'Pencahayaan dalam ruangan, cukup terang', 
                        confidence: 0.76 
                    },
                    { 
                        type: 'Estimasi Lokasi', 
                        description: 'Ruang kantor atau kamar tidur', 
                        confidence: 0.68 
                    }
                ];
                
                displayAnalysisResults(analysisResults);
                
                // Add to chat
                addMessage('Hasil analisis gambar berhasil ditampilkan', 'ai');
            }, 2000);
        }

        function displayAnalysisResults(results) {
            const resultsDiv = document.getElementById('analysisResults');
            resultsDiv.innerHTML = '<h4>📊 Hasil Analisis:</h4>';
            
            results.forEach(result => {
                const resultItem = document.createElement('div');
                resultItem.className = 'analysis-item';
                resultItem.innerHTML = `
                    <strong>${result.type}:</strong> ${result.description}
                    <div class="confidence-bar">
                        <div class="confidence-fill" style="width: ${result.confidence * 100}%"></div>
                    </div>
                    <small>Akurasi: ${Math.round(result.confidence * 100)}%</small>
                `;
                resultsDiv.appendChild(resultItem);
            });
        }

        function toggleAnalysisMode() {
            analysisMode = !analysisMode;
            
            if (analysisMode) {
                showNotification('Mode analisis real-time aktif');
                startRealTimeAnalysis();
            } else {
                showNotification('Mode analisis real-time nonaktif');
                stopRealTimeAnalysis();
            }
        }

        function startRealTimeAnalysis() {
            const resultsDiv = document.getElementById('analysisResults');
            resultsDiv.innerHTML = '<div>🔍 Mode Analisis Real-time Aktif</div>';
            
            // Simulate real-time analysis
            const analysisInterval = setInterval(() => {
                if (!analysisMode) {
                    clearInterval(analysisInterval);
                    return;
                }
                
                const randomAnalysis = [
                    'Mendeteksi gerakan tangan',
                    'Menganalisis ekspresi wajah',
                    'Menghitung objek dalam frame',
                    'Mengukur intensitas cahaya',
                    'Mendeteksi teks dalam gambar'
                ];
                
                const randomIndex = Math.floor(Math.random() * randomAnalysis.length);
                resultsDiv.innerHTML = `<div>🔍 ${randomAnalysis[randomIndex]}...</div>`;
            }, 2000);
        }

        function stopRealTimeAnalysis() {
            analysisMode = false;
        }

        function scanText() {
            showNotification('Mempersiapkan OCR (Optical Character Recognition)...');
            
            const resultsDiv = document.getElementById('analysisResults');
            resultsDiv.innerHTML = '<div class="loading"></div> Melakukan scan teks...';
            
            // Simulate OCR processing
            setTimeout(() => {
                const scannedText = `
                    <h4>📝 Teks Terscan:</h4>
                    <div class="analysis-item">
                        <strong>Teks Terdeteksi:</strong><br>
                        "JARVIS AI Assistant<br>
                        Just A Rather Very Intelligent System<br>
                        Teknologi Terdepan untuk Kehidupan Digital"
                    </div>
                    <div class="analysis-item">
                        <strong>Bahasa:</strong> Bahasa Indonesia & English<br>
                        <strong>Akurasi OCR:</strong> 94%
                    </div>
                `;
                
                resultsDiv.innerHTML = scannedText;
                addMessage('Teks berhasil di-scan dan dianalisis', 'ai');
                
                // Offer translation
                setTimeout(() => {
                    addMessage('Apakah Anda ingin menerjemahkan teks ini ke bahasa lain?', 'ai');
                }, 1000);
                
            }, 3000);
        }

        // Update weather data
        function updateWeather() {
            // Simulate weather data update
            const temps = [25, 26, 27, 28, 29, 30, 31];
            const icons = ['☀️', '⛅', '🌤️', '🌦️'];
            const locations = ['Jakarta', 'Surabaya', 'Bandung', 'Medan'];
            
            document.getElementById('weatherTemp').textContent = 
                temps[Math.floor(Math.random() * temps.length)] + '°C';
            document.getElementById('weatherIcon').textContent = 
                icons[Math.floor(Math.random() * icons.length)];
            document.getElementById('weatherLocation').textContent = 
                locations[Math.floor(Math.random() * locations.length)] + ', ID';
        }

        // Show calculator
        function showCalculator() {
            const expression = prompt('Masukkan perhitungan matematika:');
            if (expression) {
                try {
                    const result = eval(expression.replace(/[^0-9+\-*/.() ]/g, ''));
                    addMessage(`Hasil: ${expression} = ${result}`, 'ai');
                } catch (error) {
                    addMessage('Maaf, perhitungan tidak valid. Silakan coba lagi.', 'ai');
                }
            }
        }

        // Show notification
        function showNotification(message) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.classList.add('show');
            
            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        // Update time and battery
        function updateStatus() {
            // Update time
            const now = new Date();
            document.getElementById('currentTime').textContent = 
                now.toLocaleTimeString('id-ID', {hour: '2-digit', minute: '2-digit'});
            
            // Simulate battery level
            if (navigator.getBattery) {
                navigator.getBattery().then(battery => {
                    document.getElementById('batteryLevel').textContent = 
                        Math.round(battery.level * 100) + '%';
                });
            }
            
            // Update connection status
            document.getElementById('connectionStatus').textContent = 
                navigator.onLine ? 'Online' : 'Offline';
        }

        // Initialize app
        function initApp() {
            updateStatus();
            updateWeather();
            
            // Update status every minute
            setInterval(updateStatus, 60000);
            
            // Update weather every 10 minutes
            setInterval(updateWeather, 600000);
            
            // Welcome message with voice
            setTimeout(() => {
                speakResponse('Halo! Saya JARVIS, asisten virtual Anda. Bagaimana saya bisa membantu Anda hari ini?');
            }, 2000);
        }

        // Start the app
        document.addEventListener('DOMContentLoaded', initApp);

        // Handle online/offline events
        window.addEventListener('online', () => {
            showNotification('Koneksi internet tersambung');
            updateStatus();
        });

        window.addEventListener('offline', () => {
            showNotification('Koneksi internet terputus');
            updateStatus();
        });
    </script>
</body>
</html>
